+class HomeostaticThreshold(nn.Module):
+    """The HomeoLayer controller in place of the layer's normalization: one threshold per sample,
+    theta <- theta + lr * phi_bar * (r_bar - r*), from the layer's spikes alone. r_bar is the mean
+    spike count and phi_bar the mean one-bit flip statistic, both over `window` steps and floored at
+    `phi_floor`; r* = target_min + (1 - target_min) sigmoid(rho) is trained. The threshold restarts
+    at `init` for every sequence and is detached between steps."""
+
+    def __init__(self, target=0.112, lr=10.0, window=5, phi_floor=1e-2, init=1.0, target_min=5e-3,
+                 learn_target=True):
+        super().__init__()
+        self.lr, self.window, self.phi_floor, self.init = float(lr), int(window), float(phi_floor), float(init)
+        self.target_min, self.learn_target = float(target_min), bool(learn_target)
+        self.target = float(target)
+        if self.learn_target:
+            t = min(max((self.target - self.target_min) / (1 - self.target_min), 1e-4), 1 - 1e-4)
+            self.rho = nn.Parameter(torch.tensor(math.log(t / (1 - t))))
+        self.theta = None
+
+    def start(self, batch_size, device, dtype):
+        """Begin a sequence: theta [B] at `init`, statistics cleared. Returns theta as [B, 1]."""
+        self.theta = torch.full((batch_size,), self.init, device=device, dtype=dtype)
+        self.prev = None
+        self._r, self._p = [], []
+        return self.theta.unsqueeze(1)
+
+    def step(self, st):
+        """Consume this timestep's spikes [B, N]; return the threshold for the next step, [B, 1]."""
+        with torch.no_grad():
+            r = st.mean(dim=1)
+            if self.prev is None:
+                phi = torch.full_like(r, self.phi_floor)
+            else:
+                flip = 0.5 * (self.prev * (1 - st) + (1 - self.prev) * st)
+                phi = flip.mean(dim=1).clamp(min=self.phi_floor)
+            self.prev = st.detach()
+            self._r.append(r)
+            self._p.append(phi)
+            if len(self._r) > self.window:
+                self._r.pop(0)
+                self._p.pop(0)
+            r_bar = torch.stack(self._r, 0).mean(0)
+            phi_bar = torch.stack(self._p, 0).mean(0)
+        target = (self.target_min + (1 - self.target_min) * torch.sigmoid(self.rho)) if self.learn_target else self.target
+        self.theta = self.theta.detach() + self.lr * phi_bar * (r_bar - target)
+        return self.theta.unsqueeze(1)
+
